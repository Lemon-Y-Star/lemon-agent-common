<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lemon</groupId>
        <artifactId>lemon-agent-backend</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>lemon-agent-backend-service-core</artifactId>
    <description>核心服务层：账号与连接管理的领域服务</description>
    <dependencies>
        <dependency>
            <groupId>com.lemon</groupId>
            <artifactId>architecture-service-core</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lemon-agent-backend-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lemon-agent-backend-util</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lemon-agent-backend-dal</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 事件 payload 序列化：Jackson 3（Spring Boot 4 默认，包名 tools.jackson） -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- SSE 发布器持有 SseEmitter（web 专属类型，service-core 只作为发布句柄） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
